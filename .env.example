# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=nljm
POSTGRES_PASSWORD=nljm
POSTGRES_DB=nljm
DATABASE_URL=postgresql+psycopg://nljm:nljm@localhost:5432/nljm

# Adzuna: free key from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=nl

# Comma-separated Greenhouse board tokens (the <token> in boards.greenhouse.io/<token>)
GREENHOUSE_BOARDS=
